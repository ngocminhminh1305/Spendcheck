@@ -0,0 +1,30 @@
+# Module 1: Transaction Entity Extractor (rules -> spaCy -> GLiNER).
+# Build context is this folder:  docker build -t spendcheck/extractor services/extractor
+FROM python:3.12-slim
+
+ENV PYTHONDONTWRITEBYTECODE=1 \
+    PYTHONUNBUFFERED=1 \
+    HF_HOME=/models/hf
+
+WORKDIR /app
+
+# Create the runtime user and its model folder first: downloading the models as that user avoids a
+# later `chown -R`, which would copy every model file into a new image layer (+600 MB).
+RUN useradd --create-home --uid 10001 appuser && mkdir -p /models && chown appuser /models
+
+COPY requirements.txt .
+# CPU-only PyTorch first: the default wheel bundles CUDA libraries (several GB) that a CPU-only
+# server never uses. The requirements pin the same version, so pip keeps this build.
+RUN pip install --no-cache-dir torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu \
+ && pip install --no-cache-dir -r requirements.txt \
+ && python -m spacy download en_core_web_sm
+
+USER appuser
+# Download the GLiNER weights at build time, so the first request is not slow and the container
+# never needs internet access at runtime.
+RUN python -c "from gliner import GLiNER; GLiNER.from_pretrained('urchade/gliner_small-v2.1')"
+
+COPY app ./app
+
+EXPOSE 8000
+CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
diff --git a/incoming/team-repo/services/extractor/app/extractor.py b/services/extractor/app/extractor.py
