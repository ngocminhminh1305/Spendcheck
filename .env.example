# Copy to .env (never commit .env). Used by docker compose.

# Database passwords (letters and digits only: they are placed inside connection URLs)
POSTGRES_PASSWORD=changeme1
APP_DB_PASSWORD=changeme2
CHAT_AGENT_DB_PASSWORD=changeme3
REPORT_READER_DB_PASSWORD=changeme4

# LLM provider: "openrouter" (free models), "anthropic" (Claude API key) or "bedrock" (AWS)
LLM_PROVIDER=openrouter
# Free OpenRouter models (20 requests/minute, 50/day), as a comma-separated list: OpenRouter uses
# the first and falls back to the next when one is down. For Claude use e.g. claude-opus-5-5.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# For LLM_PROVIDER=openrouter: free key from openrouter.ai (Keys page)
OPENROUTER_API_KEY=

# For LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# For LLM_PROVIDER=bedrock
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
