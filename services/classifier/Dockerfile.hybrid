# Select an offline model and its versioned hybrid bundle; no training in the image.
FROM python:3.12-slim
ARG MODEL_DIRECTORY=models/minilm
ARG BUNDLE=bundles/default/manifest.json
ARG WITH_ENCODERS=1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    CLASSIFIER_BUNDLE=/code/${BUNDLE}
WORKDIR /code
COPY requirements.txt requirements-encoders.txt ./
RUN if [ "$WITH_ENCODERS" = "1" ]; then \
      pip install --no-cache-dir torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu \
      && pip install --no-cache-dir -r requirements-encoders.txt; \
    else pip install --no-cache-dir -r requirements.txt; fi \
    && useradd --create-home --uid 10001 classifier
COPY --chown=classifier:classifier app ./app
COPY --chown=classifier:classifier ${MODEL_DIRECTORY}/ /code/${MODEL_DIRECTORY}/
COPY --chown=classifier:classifier ${BUNDLE} /code/${BUNDLE}
COPY --chown=classifier:classifier bundles/default/metadata.json /code/bundles/default/metadata.json
COPY --chown=classifier:classifier data/catalogues/catalogue_development.csv data/catalogues/catalogue_post_selection.csv /code/data/catalogues/
USER classifier
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
